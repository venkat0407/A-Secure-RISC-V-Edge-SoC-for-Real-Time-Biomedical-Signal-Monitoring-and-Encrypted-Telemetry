addSignal -h 15 /tb_top/dut/u_gpio/s_axi_awvalid
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/u_gpio/s_axi_wdata[31:0]
addSignal -h 15 /tb_top/dut/u_gpio/s_axi_wvalid
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/u_gpio/s_axi_rdata[31:0]
addSignal -h 15 /tb_top/dut/u_gpio/s_axi_rvalid

