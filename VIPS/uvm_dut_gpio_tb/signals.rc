addGroup "4. CPU Master AXI Bus (s00_axi_*)"
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/s00_axi_awaddr[31:0]
addSignal -h 15 /tb_top/dut/s00_axi_awvalid
addSignal -h 15 /tb_top/dut/s00_axi_awready
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/s00_axi_wdata[31:0]
addSignal -h 15 /tb_top/dut/s00_axi_wvalid
addSignal -h 15 /tb_top/dut/s00_axi_wready
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/s00_axi_araddr[31:0]
addSignal -h 15 /tb_top/dut/s00_axi_arvalid
addSignal -h 15 /tb_top/dut/s00_axi_arready
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/s00_axi_rdata[31:0]
addSignal -h 15 /tb_top/dut/s00_axi_rvalid

addGroup "5. GPIO IP Block (u_gpio)"
