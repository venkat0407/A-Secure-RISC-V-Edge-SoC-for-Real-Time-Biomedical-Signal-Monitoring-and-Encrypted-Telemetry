Magic 271485
Revision Verdi_U-2023.03-SP1

; Window Layout
viewPort 0 25 1600 750 250 100

; Signal spacing
signalSpacing 5

addGroup "1. Clock & Reset"
addSignal -h 15 /tb_top/clk
addSignal -h 15 /tb_top/rst_n

addGroup "2. UVM VIP Virtual Interface (vif)"
addSignal -h 15 -color ID_RED5 /tb_top/vif/alert_led

addGroup "3. DUT Boundary Pins"
addSignal -h 15 -color ID_ORANGE5 /tb_top/dut/alert_led
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/adc_sample_data[11:0]
addSignal -h 15 /tb_top/dut/adc_sample_valid

addGroup "4. CPU Master AXI Bus (s00_axi_*)"
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/s00_axi_awaddr[31:0]
addSignal -h 15 /tb_top/dut/s00_axi_awvalid
addSignal -h 15 /tb_top/dut/s00_axi_awready
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/s00_axi_wdata[31:0]
addSignal -h 15 /tb_top/dut/s00_axi_wvalid
addSignal -h 15 /tb_top/dut/s00_axi_wready

addGroup "5. QRS Detection Engine (u_qrs)"
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/u_qrs/s_axi_awaddr[31:0]
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/u_qrs/s_axi_wdata[31:0]
addSignal -h 15 -color ID_YELLOW5 -UNSIGNED -HEX /tb_top/dut/u_qrs/ecg_in[11:0]
addSignal -h 15 /tb_top/dut/u_qrs/sample_valid
addSignal -h 15 -color ID_GREEN5 /tb_top/dut/u_qrs/peak_detected
addSignal -h 15 -color ID_RED5 /tb_top/dut/u_qrs/alert_flag
addSignal -h 15 -color ID_CYAN5 /tb_top/dut/u_qrs/alert_led_o
addSignal -h 15 -UNSIGNED -HEX /tb_top/dut/u_qrs/rr_interval[15:0]
addSignal -h 15 -UNSIGNED -DEC /tb_top/dut/u_qrs/bpm[7:0]
